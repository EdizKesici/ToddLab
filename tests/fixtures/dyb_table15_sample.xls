 <Worksheet ss:Name="Footnotes">
  <Table ss:ExpandedColumnCount="2">
      <Row>
        <Cell><Data ss:Type="String">FOOTNOTES</Data></Cell>
        <Cell><Data ss:Type="String">NOTES</Data></Cell>
      </Row>
      <Row>
        <Cell><Data ss:Type="String">Italics: data from civil registers which are incomplete or of unknown completeness.</Data></Cell>
      </Row>
      <Row>
        <Cell><Data ss:Type="String">*</Data></Cell>
        <Cell><Data ss:Type="String">Provisional. - Données provisoires.</Data></Cell>
      </Row>
      <Row>
        <Cell><Data ss:Type="String">a</Data></Cell>
        <Cell><Data ss:Type="String">'Code' indicates the source of data, as follows: C - Civil registration, estimated over 90% complete; U - Civil registration, estimated less than 90% complete; | - Other source, estimated reliable; + - Data tabulated by date of registration rather than occurrence.</Data></Cell>
      </Row>
      <Row>
        <Cell><Data ss:Type="Number">1</Data></Cell>
        <Cell><Data ss:Type="String">Data refer to the de facto population.</Data></Cell>
      </Row>
      <Row>
        <Cell><Data ss:Type="Number">2</Data></Cell>
        <Cell><Data ss:Type="String">Data include deaths registered late.</Data></Cell>
      </Row>
  </Table>
 </Worksheet>
